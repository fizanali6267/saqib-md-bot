# ==========================================
# SAQIB-MD ENVIRONMENT CONFIGURATION TEMPLATE
# (Copy this file to .env and insert your real keys)
# ==========================================

# Bot Identification
BOT_NAME="SAQIB-MD"
OWNER_NAME="Saqib Iqbal"
# Enter your international phone number without + or spaces (e.g. 923001234567)
OWNER_NUMBER=""
PREFIX="."
WORK_TYPE="public"
PORT=3000
PAIRING_LINK="https://saqib-iqbal-pairing.up.railway.app"

# Database Connection (MongoDB Atlas)
# Leave empty for local session file storage, or paste your MongoDB Atlas URI:
# e.g. "mongodb+srv://user:pass@cluster0.xxx.mongodb.net/saqib_md?retryWrites=true&w=majority"
MONGO_URI=""
SESSION_ID="saqib_md_session"

# Automation & Security Features (true / false)
ANTI_DELETE="true"
ANTI_DELETE_MODE="same"
ANTI_VIEW_ONCE="true"
AUTO_VIEW_ONCE="true"
ALWAYS_ONLINE="true"
AUTO_READ="false"
ANTI_LINK="true"
ANTI_BADWORD="true"
ANTI_CALL="false"
AUTO_REACT="true"
AUTO_REACT_MODE="sender"
AI_REACT="false"
AUTO_STATUS_READ="true"
AUTO_STATUS_REACT="true"
STATUS_REACT_EMOJI="❤️"
AUTO_BIO="false"

# Friendly AI Chatbot
CHATBOT_PM="true"
CHATBOT_GROUP="false"

# External API Keys (Optional - insert your keys here if available)
GEMINI_API_KEY=""
WEATHER_API_KEY=""
OPENAI_API_KEY=""

# Custom Sticker Pack Details
STICKER_PACK_NAME="SAQIB-MD"
STICKER_AUTHOR="Saqib Iqbal"
